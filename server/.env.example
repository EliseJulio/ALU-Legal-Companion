# Copy this file to .env and fill it in. Never commit .env.
DATABASE_URL=postgres://alu:alu_dev@localhost:5432/alu_legal

# Required. At least 32 characters. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=4000

# Browser addresses allowed to call the API. Required in production; list every allowed origin,
# separated by commas. The Vite dev server is used only outside production when this is empty.
CORS_ORIGINS=http://localhost:5173

# Set only when the app runs behind a reverse proxy. Use the number of proxies, usually 1.
# Leave it empty otherwise or a client can fake its IP address and dodge the rate limits.
TRUST_PROXY=

# Optional. Outgoing mail for email verification and reminders.
# With no SMTP_URL the server prints each email in its log and sends nothing,
# so the whole flow can be shown without a mail account.
# Port 587 needs smtp:// and port 465 needs smtps://.
# If the login contains an @, write it as %40.
SMTP_URL=
# The sender address. It must be one that your mail provider has verified.
MAIL_FROM=
# The name people see in their inbox before the address. Default: ALU Legal Companion.
# Ignored if MAIL_FROM already has a name in it ("Name <address>").
MAIL_FROM_NAME=
# Optional. Where replies go. Leave empty and replies go to the sender address.
MAIL_REPLY_TO=
# The base address that email links are built from. Default is http://localhost:5173
APP_URL=

# Deadline reminders are checked once an hour inside the server.
# Set this to off if a separate cron job runs "npm run reminders" instead.
REMINDERS=

# The key that encrypts documents people attach to a matter. It is 64 hex characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# With no key set nothing is stored and uploads answer 503. Keep it secret and keep a copy.
# If it is lost every stored document is lost with it.
DOCUMENT_KEY=

# Optional. With no REDIS_URL every rate limit is kept in the server's own memory, which is
# fine for one instance. Set this when running more than one server process so a login attempt
# or an upload still counts against the same limit no matter which process answers it.
REDIS_URL=

# Optional. Calls held inside the platform with our own signaling service. When both values are set a
# consultation joins a call there first. With either empty the call uses Daily or the Meet link.
# A long random secret shared with the signaling Worker. At least 32 characters. Keep it secret.
CALL_TICKET_SECRET=
# The secure WebSocket address of the signaling Worker. It must start with wss://. For example: wss://calls.example.org
CALL_SIGNAL_URL=
# Optional. Cloudflare Realtime TURN relays a call when the two browsers cannot reach each other
# directly. Create a TURN key in the Cloudflare dashboard (Realtime then TURN) and paste its id
# and API token. With either empty the call uses the free STUN address only.
CALL_TURN_KEY_ID=
CALL_TURN_API_TOKEN=

# Optional. Video calls inside the platform, made with Daily (daily.co). Each accepted consultation
# gets its own private room. With either value empty, the call uses the lawyer's Google Meet link.
# The API key from the Daily dashboard. Keep it secret.
DAILY_API_KEY=
# The subdomain of your Daily account, the part before .daily.co. For example: alu-legal.
DAILY_DOMAIN=
# The most new rooms made in one day (Kigali time). Empty means 20. Each room uses free minutes so this stops them running out.
# Set 0 to use only the Google Meet link.
VIDEO_ROOMS_PER_DAY=
# Leave empty. Tests point this at a stub. Default is https://api.daily.co/v1
DAILY_API_BASE=

# Optional. Ask AI answers a question from the published guides with a Google Gemini model.
# Both must be set or Ask AI answers "not available". Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
# The model id, sent to Google as written. Copy a current free-tier model id from
# https://ai.google.dev/gemini-api/docs/models. Google retires model ids over time.
GEMINI_MODEL=
# The most questions the server sends to the model in one day (UTC). Default 200. The count is held
# in the server's memory, so a restart starts it again at zero.
ASK_AI_DAILY_LIMIT=200
