# Copy to .env and fill in
DATABASE_URL=postgres://alu:alu_dev@localhost:5432/alu_legal
# REQUIRED — min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=4000

# Only set this when the app runs behind a reverse proxy: the number of proxies (usually 1).
# Leave it empty otherwise or anyone can fake their IP and get around the rate limits.
TRUST_PROXY=

CORS_ORIGINS=http://localhost:5173

# Optional: outgoing email (the verification link).
# With no SMTP_URL the app prints the email in the server log and sends nothing,
# so sign-up still works with no mail account.
# Use smtp:// for port 587 and smtps:// for port 465. If the login contains an @, write it as %40.
# Example: smtp://login:password@smtp.example.com:587
SMTP_URL=
# The sender address. It must be one your mail provider has verified.
MAIL_FROM=
# The address of the website (the frontend). The email links point here. Default http://localhost:5173
APP_URL=
