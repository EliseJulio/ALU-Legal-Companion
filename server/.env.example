# Copy this file to .env and fill it in. Never commit .env.
DATABASE_URL=postgres://alu:alu_dev@localhost:5432/alu_legal

# Required. At least 32 characters. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=4000

# Browser addresses allowed to call the API. Required in production; list every allowed origin,
# separated by commas. The Vite dev server is used only outside production when this is empty.
CORS_ORIGINS=http://localhost:5173

# Set only when the app runs behind a reverse proxy. Use the number of proxies, usually 1.
# Leave it empty otherwise or a client can fake its IP address and dodge the rate limits.
TRUST_PROXY=

# Optional. Outgoing mail for email verification and reminders.
# With no SMTP_URL the server prints each email in its log and sends nothing,
# so the whole flow can be shown without a mail account.
# Port 587 needs smtp:// and port 465 needs smtps://.
# If the login contains an @, write it as %40.
SMTP_URL=
# The sender address. It must be one that your mail provider has verified.
MAIL_FROM=
# The base address that email links are built from. Default is http://localhost:5173
APP_URL=

# Deadline reminders are checked once an hour inside the server.
# Set this to off if a separate cron job runs "npm run reminders" instead.
REMINDERS=

# The key that encrypts documents people attach to a matter. It is 64 hex characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# With no key set nothing is stored and uploads answer 503. Keep it secret and keep a copy.
# If it is lost every stored document is lost with it.
DOCUMENT_KEY=

# Optional. With no REDIS_URL every rate limit is kept in the server's own memory, which is
# fine for one instance. Set this when running more than one server process so a login attempt
# or an upload still counts against the same limit no matter which process answers it.
REDIS_URL=
